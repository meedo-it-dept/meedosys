# PocketBase Configuration
# Default local PocketBase instance (http://127.0.0.1:8090 or your intranet server IP)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@meedosys.local
POCKETBASE_ADMIN_PASSWORD=your-strong-admin-password

# Legacy Supabase compatibility (optional fallback)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Municipal Metadata & Notifications
NEXT_PUBLIC_MUNICIPALITY_NAME="Municipality of Malungon"
NEXT_PUBLIC_OFFICE_NAME="MEEDO - Municipal Economic Enterprise Development Office"

# Firebase Authentication Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
